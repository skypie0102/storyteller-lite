import { Button, ComboBox, HorizontalBox, Palette, ProgressIndicator, VerticalBox } from "std-widgets.slint";

export struct QueueRow {
    position: string,
    title: string,
    status: string,
}

export struct StageRow {
    label: string,
    state: string,
}

export struct StageDetailRow {
    label: string,
    state: string,
    elapsed: string,
    activity: string,
}

export component AppWindow inherits Window {
    title: "Storyteller OneClick Lite";
    preferred-width: 1040px;
    preferred-height: 760px;
    min-width: 820px;
    min-height: 620px;

    in-out property <string> status-text: "Ready";
    in-out property <string> epub-source-name: "";
    in-out property <string> audio-source-name: "";
    in-out property <string> codec-text: "Opus";
    in-out property <string> bitrate-text: "64K";
    in property <[QueueRow]> queue-rows;
    in property <bool> queue-paused: false;

    in property <bool> has-active-job: false;
    in property <string> active-title: "";
    in property <float> active-overall-progress: 0;
    in property <string> active-progress-text: "0%";
    in property <string> active-activity-text: "";
    in property <string> active-context-text: "";
    in property <string> active-timing-text: "";
    in property <string> active-metrics-text: "";
    in property <string> pause-action-text: "Pause after book";
    in property <[StageRow]> active-stages;
    in property <[StageDetailRow]> active-stage-details;

    callback browse-epub();
    callback browse-audio();
    callback queue-book();
    callback open-settings();
    callback pause-after-book();
    callback cancel-current();
    callback resume-queue();

    VerticalBox {
        padding: 24px;
        spacing: 18px;

        HorizontalBox {
            spacing: 12px;

            Text {
                text: "Storyteller OneClick Lite";
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.status-text;
                vertical-alignment: center;
                opacity: 0.72;
            }

            Button {
                text: "Settings";
                clicked => { root.open-settings(); }
            }
        }

        Rectangle {
            min-height: 1px;
            max-height: 1px;
            background: Palette.border;
            opacity: 0.5;
        }

        if !root.has-active-job : VerticalBox {
            spacing: 16px;

            Text {
                text: "CREATE READ-ALOUD EPUB";
                font-size: 14px;
                font-weight: 700;
                opacity: 0.72;
            }

            HorizontalBox {
                spacing: 16px;

                Rectangle {
                    horizontal-stretch: 1;
                    min-height: 165px;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 10px;

                    VerticalBox {
                        padding: 20px;
                        spacing: 10px;

                        Text { text: "EPUB"; font-size: 18px; font-weight: 700; }
                        Text {
                            text: root.epub-source-name == "" ? "Drop file here" : root.epub-source-name;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.epub-source-name == "" ? "or click to browse" : "Click to choose a different EPUB";
                            horizontal-alignment: center;
                            opacity: 0.62;
                        }
                    }
                    TouchArea { clicked => { root.browse-epub(); } }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-height: 165px;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 10px;

                    VerticalBox {
                        padding: 20px;
                        spacing: 10px;
                        Text { text: "AUDIOBOOK"; font-size: 18px; font-weight: 700; }
                        Text {
                            text: root.audio-source-name == "" ? "Drop file here" : root.audio-source-name;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-stretch: 1;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.audio-source-name == "" ? "or click to browse" : "Click to choose different audio";
                            horizontal-alignment: center;
                            opacity: 0.62;
                        }
                    }
                    TouchArea { clicked => { root.browse-audio(); } }
                }
            }

            HorizontalBox {
                spacing: 10px;
                Text { text: "Encoding"; vertical-alignment: center; font-weight: 600; }
                ComboBox {
                    model: ["Copy", "Opus", "AAC"];
                    current-index: 1;
                    selected(value) => { root.codec-text = value; }
                }
                ComboBox {
                    model: ["32K", "64K", "96K"];
                    current-index: 1;
                    enabled: root.codec-text != "Copy";
                    selected(value) => { root.bitrate-text = value; }
                }
                Text { text: "Output: Next to source"; vertical-alignment: center; opacity: 0.72; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Unmatched audio: Smart"; vertical-alignment: center; opacity: 0.72; }
                Button { text: "Queue Book"; primary: true; clicked => { root.queue-book(); } }
            }
        }

        if root.has-active-job : Rectangle {
            min-height: 64px;
            max-height: 64px;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 10px;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text { text: "QUEUE ANOTHER BOOK"; font-size: 12px; font-weight: 700; opacity: 0.72; vertical-alignment: center; }
                Button {
                    text: root.epub-source-name == "" ? "Choose EPUB" : root.epub-source-name;
                    clicked => { root.browse-epub(); }
                }
                Button {
                    text: root.audio-source-name == "" ? "Choose audio" : root.audio-source-name;
                    clicked => { root.browse-audio(); }
                }
                ComboBox {
                    model: ["Copy", "Opus", "AAC"];
                    current-index: root.codec-text == "Copy" ? 0 : root.codec-text == "AAC" ? 2 : 1;
                    selected(value) => { root.codec-text = value; }
                }
                ComboBox {
                    model: ["32K", "64K", "96K"];
                    current-index: root.bitrate-text == "32K" ? 0 : root.bitrate-text == "96K" ? 2 : 1;
                    enabled: root.codec-text != "Copy";
                    selected(value) => { root.bitrate-text = value; }
                }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Queue"; primary: true; clicked => { root.queue-book(); } }
            }
        }

        if root.has-active-job : VerticalBox {
            spacing: 12px;
            Text { text: "ACTIVE JOB"; font-size: 14px; font-weight: 700; opacity: 0.72; }

            Rectangle {
                min-height: 250px;
                border-width: 1px;
                border-color: Palette.border;
                border-radius: 10px;

                VerticalBox {
                    padding: 18px;
                    spacing: 10px;

                    HorizontalBox {
                        spacing: 12px;
                        Text {
                            text: root.active-title;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.active-progress-text;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    ProgressIndicator { progress: root.active-overall-progress; }
                    Text { text: root.active-activity-text; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                    if root.active-context-text != "" : Text { text: root.active-context-text; opacity: 0.72; wrap: word-wrap; }

                    HorizontalBox {
                        spacing: 6px;
                        for stage in root.active-stages : Rectangle {
                            horizontal-stretch: 1;
                            min-height: 48px;
                            border-width: 1px;
                            border-color: stage.state == "Active" ? Palette.accent-background : Palette.border;
                            border-radius: 7px;
                            background: stage.state == "Active" ? Palette.accent-background : Palette.alternate-background;
                            VerticalBox {
                                padding-left: 7px;
                                padding-right: 7px;
                                padding-top: 5px;
                                padding-bottom: 5px;
                                spacing: 1px;
                                Text {
                                    text: stage.label;
                                    font-size: 12px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    color: stage.state == "Active" ? Palette.accent-foreground : Palette.alternate-foreground;
                                }
                                Text {
                                    text: stage.state;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    opacity: 0.72;
                                    color: stage.state == "Active" ? Palette.accent-foreground : Palette.alternate-foreground;
                                }
                            }
                        }
                    }

                    if root.active-timing-text != "" : Text { text: root.active-timing-text; opacity: 0.78; wrap: word-wrap; }

                    HorizontalBox {
                        spacing: 10px;
                        if root.active-metrics-text != "" : Text {
                            text: root.active-metrics-text;
                            opacity: 0.78;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            wrap: word-wrap;
                        }
                        if root.active-metrics-text == "" : Rectangle { horizontal-stretch: 1; }
                        Button { text: "Cancel"; clicked => { root.cancel-current(); } }
                        Button {
                            text: root.pause-action-text;
                            enabled: root.pause-action-text != "Pause requested";
                            clicked => { root.pause-after-book(); }
                        }
                    }
                }
            }
        }

        Rectangle { min-height: 1px; max-height: 1px; background: Palette.border; opacity: 0.5; }

        HorizontalBox {
            spacing: 10px;
            Text { text: "QUEUE"; font-size: 14px; font-weight: 700; opacity: 0.72; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            if root.queue-paused : Text { text: "Paused"; opacity: 0.72; vertical-alignment: center; }
            if root.queue-paused : Button { text: "Resume queue"; clicked => { root.resume-queue(); } }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 150px;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 10px;

            VerticalBox {
                padding: 12px;
                spacing: 6px;
                if root.queue-rows.length == 0 : Text {
                    text: root.has-active-job ? "No other books waiting." : "No books waiting.";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                    opacity: 0.62;
                }
                for row in root.queue-rows : Rectangle {
                    min-height: 46px;
                    max-height: 46px;
                    border-width: 1px;
                    border-color: Palette.border;
                    border-radius: 7px;
                    HorizontalBox {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Text { text: row.position; min-width: 28px; max-width: 28px; vertical-alignment: center; opacity: 0.58; }
                        Text { text: row.title; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; font-weight: 600; }
                        Text { text: row.status; vertical-alignment: center; opacity: 0.68; }
                    }
                }
            }
        }
    }
}
